{
  "name": "lazy-to-text-desktop",
  "productName": "Lazy to Text",
  "version": "0.2.2",
  "private": true,
  "description": "Electron interface for Lazy to Text, built on @monos/ui",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Alexander Blinov",
    "email": "iam@blinovcorp.ru"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "electron .",
    "test": "vitest run",
    "pack": "npm run build && node scripts/dist.mjs --dir",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:mac": "npm run build && node scripts/dist.mjs --mac",
    "dist:win": "npm run build && node scripts/dist.mjs --win",
    "dist:linux": "npm run build && node scripts/dist.mjs --linux"
  },
  "devDependencies": {
    "@monos/ui": "github:aa-blinov/monos-ui",
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@testing-library/svelte": "^5.2.8",
    "autoprefixer": "^10.4.16",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^24.1.1",
    "lucide-svelte": "^0.302.0",
    "postcss": "^8.4.32",
    "svelte": "^4.2.7",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/aa-blinov/lazy-to-text"
}
