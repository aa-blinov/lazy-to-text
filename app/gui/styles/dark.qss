/* Dark theme. Token placeholders are substituted at load time — see theme.py. */

/* THE INK-ON-FILL RULE. A label sitting on a *saturated* fill — accent,
   danger, warning — is the window ground, never Ink Primary. Measured:
   Ink Primary #fbf1c7 on the Sage fill is 2.37:1, far under the 4.5:1 AA
   floor; #1d2021 on the same fill is 6.09:1, and 9.56:1 on its hover,
   4.77:1 on danger, 6.61:1 on warning. It is 3.03:1 on danger and 2.19:1
   on warning, so "bright cream on a saturated fill" is never the answer.
   The app already worked this way on the loading pill and the
   warning-banner button, so the exceptions were drift, not intent.

   Focus rings are the deliberate opposite and must stay Ink Primary.
   A ring's outer edge meets the window ground, where Ink Primary reads
   at 14.45:1; the label next to it going dark changes nothing about
   that. */

QWidget {
    background-color: {{color.bg_primary}};
    color: {{color.text_primary}};
    font-family: {{font.family}};
    font-size: {{font.size_body}};
}

QMainWindow,
QDialog {
    background-color: {{color.bg_primary}};
}

QLabel {
    background-color: transparent;
    color: {{color.text_primary}};
}

QLabel[role="title"] {
    font-size: {{font.size_title}};
    font-weight: 600;
    color: {{color.text_primary}};
}

QLabel[role="heading"] {
    font-size: {{font.size_heading}};
    font-weight: 600;
    color: {{color.text_primary}};
}

QLabel[role="muted"] {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
}

/* ``text_muted``, not ``accent_hover``.

   This was an accent-tier value doing a muted label's job, which broke
   the One Accent Rule twice over: the accent means focus, selection or
   a primary action, and a section header is none of them. It is chrome,
   so it belongs on the chrome token — and since ``text_muted`` was
   lifted to AA, the two would have shared a value by accident rather
   than by decision, which is worse. */
QLabel[role="section-header"] {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding-bottom: 2px;
}

QLabel[role="empty-title"] {
    color: {{color.text_primary}};
    font-size: {{font.size_heading}};
    font-weight: 600;
}

QLabel[role="empty-hint"] {
    color: {{color.text_muted}};
    font-size: {{font.size_body}};
}

/* The page's one line of purpose, under the title. Ink Secondary, not
   Ink Muted: this is the line that explains what the section is *for*,
   so it has to survive being read, and Ink Muted is already the known
   contrast debt elsewhere in the app. */
QLabel[role="subtitle"] {
    color: {{color.text_secondary}};
    font-size: {{font.size_body}};
}

/* A hotkey as a key cap. Monospaced, because the characters have to
   line up with the neighbouring cap, and because a hotkey read at a
   glance is a shape-recognition job — proportional digits and letters
   make "Ctrl+F2" and "Ctrl+F3" look like the same string. */
QLabel[role="kbd"] {
    background-color: {{color.bg_elevated}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    color: {{color.text_primary}};
    font-family: {{font.mono}};
    font-size: {{font.size_small}};
    font-weight: 600;
    padding: 4px 10px;
}

QLabel#EmptyStateGlyph {
    background: transparent;
    border: none;
}

QLabel[role="test-result-good"] {
    color: {{color.success}};
    font-size: {{font.size_small}};
    font-weight: 500;
}

QLabel[role="test-result-warn"] {
    color: {{color.warning}};
    font-size: {{font.size_small}};
    font-weight: 500;
}

QLabel[role="test-result-bad"] {
    color: {{color.danger}};
    font-size: {{font.size_small}};
    font-weight: 500;
}

/* ---- Buttons ------------------------------------------------------------- */

QPushButton {
    background-color: {{color.bg_elevated}};
    color: {{color.text_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: 9px 18px;
    font-weight: 500;
    min-height: 16px;
}

QPushButton:hover {
    background-color: {{color.bg_hover}};
    border-color: {{color.accent}};
}

QPushButton:pressed {
    background-color: {{color.bg_secondary}};
}

QPushButton:disabled {
    color: {{color.text_muted}};
    background-color: {{color.bg_secondary}};
    border-color: {{color.border}};
}

/* Focus is a 2px ring, not a 1px shift. The base border is a hairline
   in the same value the hover state already moves to, so a 1px focus
   border would be indistinguishable from hover — and on a dark ground
   a keyboard user has to find focus without the pointer that would
   otherwise be hovering the control. Padding drops by 1px on each
   axis so the ring grows inward and the button keeps its exact
   painted size: focus must never reflow what the user just tabbed to. */
QPushButton:focus {
    border: 2px solid {{color.accent}};
    padding: 7px 17px;
}

QPushButton[role="primary"] {
    background-color: {{color.accent}};
    color: {{color.bg_primary}};
    border: 1px solid {{color.accent}};
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: {{color.accent_hover}};
    border-color: {{color.accent_hover}};
}

QPushButton[role="primary"]:disabled {
    background-color: {{color.bg_elevated}};
    color: {{color.text_muted}};
    border-color: {{color.border}};
}

/* An accent ring on an accent fill is invisible, so the primary
   button's focus ring is the system's highest-contrast ink instead.
   Against the Graphite ground outside the button it reads instantly. */
QPushButton[role="primary"]:focus {
    border: 2px solid {{color.text_primary}};
    padding: 7px 17px;
}

/* Destructive action — outlined in danger red, filled on hover. The
   subdued resting state keeps it visually subordinate to the primary
   action sitting next to it (Select/Download). */
QPushButton[role="danger"] {
    background-color: transparent;
    color: {{color.danger}};
    border: 1px solid {{color.danger}};
    font-weight: 500;
}

QPushButton[role="danger"]:hover {
    background-color: {{color.danger}};
    color: {{color.bg_primary}};
}

QPushButton[role="danger"]:disabled {
    color: {{color.text_muted}};
    border-color: {{color.border}};
}

/* Danger keeps its own hue for focus — red *is* this control's
   identity, and switching it to the accent would read as a different
   action. 2px rather than 1px for the same visibility reason as the
   default button. */
QPushButton[role="danger"]:focus {
    border: 2px solid {{color.danger}};
    padding: 7px 17px;
}

/* ---- Cards --------------------------------------------------------------- */

QFrame[role="card"] {
    background-color: {{color.bg_secondary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.lg}};
}

QFrame[role="card"]:hover {
    border-color: {{color.accent_hover}};
}

QFrame[role="card"][active="true"] {
    border: 1px solid {{color.accent}};
    background-color: {{color.bg_elevated}};
}

/* The card is a tab stop so that focus has somewhere deliberate to
   land when a card's Download button hides itself. An active card is
   already an accent-bordered card, so the ring is only drawn for the
   inactive case — the accent is free to mean "this is the loaded
   model" there. */
QFrame[role="card"]:focus {
    border: 2px solid {{color.accent}};
    padding: 0px;
}

QFrame[role="card"][active="true"]:focus {
    border: 2px solid {{color.text_primary}};
}

/* ---- Badges + pills ------------------------------------------------------ */

/* ---- Filter chips in the Models toolbar -------------------------------- */

QPushButton[role="filter-chip"] {
    background-color: {{color.bg_elevated}};
    color: {{color.text_secondary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: 4px 12px;
    font-size: {{font.size_small}};
    font-weight: 500;
    min-height: 18px;
}

QPushButton[role="filter-chip"]:hover {
    background-color: {{color.bg_hover}};
    color: {{color.text_primary}};
    border-color: {{color.accent_hover}};
}

QPushButton[role="filter-chip"]:checked {
    background-color: {{color.accent}};
    color: {{color.bg_primary}};
    border-color: {{color.accent}};
}

QPushButton[role="filter-chip"]:focus {
    border: 2px solid {{color.accent}};
    padding: 3px 11px;
}

/* A checked chip is an accent fill, so its focus ring switches to ink
   for the same reason the primary button's does. */
QPushButton[role="filter-chip"]:checked:focus {
    border: 2px solid {{color.text_primary}};
    padding: 3px 11px;
}

/* ---- Inference settings panel inside an active card -------------------- */

QFrame[role="inference-panel"] {
    background-color: transparent;
    border-top: 1px solid {{color.border}};
    margin-top: {{space.sm}};
    padding-top: {{space.sm}};
}

QFrame[role="inference-panel"] QSpinBox,
QFrame[role="inference-panel"] QDoubleSpinBox {
    background-color: {{color.bg_secondary}};
    color: {{color.text_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: 4px 8px;
    selection-background-color: {{color.accent}};
}

QFrame[role="inference-panel"] QSpinBox:focus,
QFrame[role="inference-panel"] QDoubleSpinBox:focus {
    border-color: {{color.accent}};
}

/* Belt-and-braces with ``setButtonSymbols(NoButtons)``: when a
   spinbox is otherwise styled via QSS, Qt on Windows can still
   render the native up/down sub-controls. Collapse the
   sub-controls to zero size so the body of the field stays a
   clean rounded rectangle that matches the other inputs. */
QFrame[role="inference-panel"] QSpinBox::up-button,
QFrame[role="inference-panel"] QSpinBox::down-button,
QFrame[role="inference-panel"] QDoubleSpinBox::up-button,
QFrame[role="inference-panel"] QDoubleSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

QFrame[role="inference-panel"] QSpinBox::up-arrow,
QFrame[role="inference-panel"] QSpinBox::down-arrow,
QFrame[role="inference-panel"] QDoubleSpinBox::up-arrow,
QFrame[role="inference-panel"] QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
}

/* The model card's metadata is a spec line now, not a row of pills —
   see the note in model_card.py. Its one coloured word is "fast", and it
   is drawn inline from ``success`` rather than from the stylesheet,
   because rich text cannot be styled by QSS. That was the last reader of
   the model-family hues, so the tint palette is gone from theme.py. */

QLabel[role="pill-active"] {
    background-color: {{color.success}};
    color: {{color.bg_primary}};
    border-radius: {{radius.sm}};
    padding: 4px {{space.md}};
    font-size: {{font.size_small}};
    font-weight: 600;
}

QLabel[role="pill-active"][state="loading"] {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
}

/* "Recommended" is not a state and must not borrow success, which is
   what "Active" uses: a user who has deliberately loaded a different
   model should see Recommended and Active side by side and not read
   them as the same answer twice. Accent outline, not a fill, because a
   filled pill next to the filled Active pill would pull the eye to the
   suggestion over the truth. */
QLabel[role="pill-recommended"] {
    background-color: transparent;
    color: {{color.accent}};
    border: 1px solid {{color.accent}};
    border-radius: {{radius.sm}};
    padding: 4px {{space.md}};
    font-size: {{font.size_small}};
    font-weight: 600;
}

/* The one-sentence answer, in place of the measured case. Full
   ``text_primary`` and body size: it is the reason the card is on this
   screen, where the description it replaces was muted because it is
   reference material rather than the answer. */
QLabel[role="pitch"] {
    color: {{color.text_primary}};
    font-size: {{font.size_body}};
    line-height: 1.4;
}

/* ---- First run --------------------------------------------------------- */

/* A text link, not a button. "Set up later" and "See all models instead"
   are two ways out of a screen, and the design system's `default` button
   would give each of them the weight of the one thing the screen is
   asking the user to do. */
QPushButton[role="link"] {
    background-color: transparent;
    border: none;
    color: {{color.accent}};
    padding: {{space.xs}} 0;
    font-size: {{font.size_body}};
    text-align: left;
}

QPushButton[role="link"]:hover {
    color: {{color.text_primary}};
    text-decoration: underline;
}

QPushButton[role="link"]:focus {
    color: {{color.text_primary}};
}

/* A determinate bar the user can read without a legend. The chunk is
   `accent`, the track is one step up from the page — not `bg_secondary`,
   which is what the cards use, because this bar sits on the page and a
   card-coloured track would draw a card's edge around it. */
QProgressBar#FirstRunProgress {
    background-color: {{color.bg_elevated}};
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar#FirstRunProgress::chunk {
    background-color: {{color.accent}};
    border-radius: 3px;
}

/* ---- Toast --------------------------------------------------------------- */

QFrame[role="toast"] {
    background-color: {{color.bg_elevated}};
    border: 1px solid {{color.accent}};
    border-radius: {{radius.md}};
}

QLabel[role="toast-title"] {
    color: {{color.success}};
    font-weight: 600;
    font-size: {{font.size_small}};
}

QLabel[role="toast-body"] {
    color: {{color.text_primary}};
    font-size: {{font.size_body}};
}

/* ---- Recording Overlay -------------------------------------------------- */

#RecordingOverlay {
    background: transparent;
    border: none;
}

QFrame[role="recording-overlay-surface"] {
    background-color: {{color.bg_elevated}};
    border: 1px solid {{color.border}};
    border-radius: 24px;
}

/* Four named states, plus a base that means "none of them yet".
   The base is muted rather than red on purpose: it is what the dot
   paints before ``show_delivery`` or ``set_state`` hands it a state,
   and while it was danger it silently doubled as the recording colour,
   which made the ``[state="failed"]`` rule below a second copy of the
   same declaration — one whose removal nothing could observe. */
QFrame[role="recording-overlay-dot"] {
    background-color: {{color.text_muted}};
    border-radius: 7px;
}

QFrame[role="recording-overlay-dot"][state="recording"] {
    background-color: {{color.danger}};
}

QFrame[role="recording-overlay-dot"][state="processing"] {
    background-color: {{color.warning}};
}

QFrame[role="recording-overlay-dot"][state="copied"],
QFrame[role="recording-overlay-dot"][state="pasted"] {
    background-color: {{color.success}};
}

QFrame[role="recording-overlay-dot"][state="failed"] {
    background-color: {{color.danger}};
}

QLabel[role="recording-overlay-title"] {
    color: {{color.text_primary}};
    font-size: {{font.size_small}};
    font-weight: 700;
}

QLabel[role="recording-overlay-body"] {
    color: {{color.text_secondary}};
    font-size: {{font.size_small}};
}

/* ---- TopBar -------------------------------------------------------------- */

#TopBar {
    background-color: {{color.bg_secondary}};
    border-bottom: 1px solid {{color.border}};
}

/* Empty zone above the sidebar — same horizontal footprint, no
   visible border. Just keeps the topbar's content aligned to the
   sidebar's right edge. */
#TopBarGutter {
    background-color: transparent;
}

/* Which model the app is listening with. Three states, and they are
   the same three the card's Active pill uses — the topbar chip and the
   card chip report one fact, and they used to report it in two
   different colours. It was also tinted with the *whisper* family hue
   no matter which model was loaded, which was arbitrary: a family
   colour has no opinion about Parakeet. */
QLabel[role="model-pill"] {
    background-color: {{color.success}};
    color: {{color.bg_primary}};
    border: 1px solid {{color.success}};
    border-radius: {{radius.sm}};
    padding: 4px {{space.md}};
    font-size: {{font.size_small}};
    font-weight: 600;
}

QLabel[role="model-pill"][state="empty"] {
    background-color: {{color.bg_elevated}};
    color: {{color.text_muted}};
    border: 1px solid {{color.border}};
}

QLabel[role="model-pill"][state="loading"] {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
    border: 1px solid {{color.warning}};
}

/* Sidebar's bottom-left status chip — same shape as a single
   ResourceWidget block (CPU / RAM): rounded card with a muted
   label on top-left, state value on top-right, VU bar underneath.
   The ENGINE line reports the live ONNX Runtime execution provider;
   it is a text chip (role="chip-value"), not a filled pill — an
   earlier filled "engine pill" was designed, never wired up, and its
   rules were removed rather than left to rot. */
#RecordingStatusWidget {
    background-color: {{color.bg_elevated}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    /* Outer spacing lives on the parent ``RecordingStatusHolder``
       widget (sidebar.py) — Qt's QStyle routes QSS ``margin`` for
       plain QWidgets unreliably, so layout contentsMargins is the
       safer source of truth for the bottom alignment with
       ModelsView's content padding. */
}

QLabel[role="chip-label"] {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel[role="chip-value"] {
    font-size: {{font.size_small}};
    font-weight: 600;
    background: transparent;
}

QLabel[role="chip-value"][state="idle"] {
    color: {{color.text_secondary}};
}

QLabel[role="chip-value"][state="recording"] {
    color: {{color.danger}};
}

QLabel[role="chip-value"][state="processing"] {
    color: {{color.accent}};
}

/* Cancel button next to the loading model pill — visible only while
   the backend is downloading / importing. Compact, danger-tinted so
   the user sees it as the escape hatch it is, but soft enough that
   it doesn't dominate the topbar. */
QPushButton[role="cancel-load"] {
    background-color: transparent;
    color: {{color.danger}};
    border: 1px solid {{color.danger}};
    border-radius: {{radius.sm}};
    padding: 3px {{space.sm}};
    font-size: {{font.size_small}};
    font-weight: 600;
}

QPushButton[role="cancel-load"]:hover {
    background-color: {{color.danger}};
    color: {{color.bg_primary}};
}

QPushButton[role="cancel-load"]:pressed {
    background-color: {{color.danger}};
    color: {{color.bg_primary}};
    padding-top: 4px;
    padding-bottom: 2px;
}

QPushButton[role="cancel-load"]:focus {
    border: 2px solid {{color.danger}};
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
}

/* ---- Sidebar ------------------------------------------------------------- */

#Sidebar {
    background-color: {{color.bg_secondary}};
    border-right: 1px solid {{color.border}};
}

#SidebarList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: {{space.sm}} {{space.xs}};
}

#SidebarList::item {
    padding: 10px 14px;
    margin: 2px {{space.sm}};
    border-radius: {{radius.sm}};
    color: {{color.text_secondary}};
}

#SidebarList::item:hover {
    background-color: {{color.bg_elevated}};
    color: {{color.text_primary}};
}

#SidebarList::item:selected {
    background-color: {{color.accent}};
    color: {{color.bg_primary}};
}

/* The whole sidebar is one tab stop — the list itself, not its items —
   so QSS can only frame the widget, and a border around a 200 × 601 px
   column reads as a stray border rather than a focus indicator. The
   focused state is the selected row's fill lifting to accent_focus,
   applied as a widget-level stylesheet from ``sidebar.py``. A delegate
   cannot do it: Qt hands one the unmargined item rect (192 px) while
   this stylesheet paints the pill inset by its own margin (12..187), so
   a stroke lands ~11 px off the fill on one side. Do not add a rule
   here for a ring — there is none. */

/* ---- Scrollbars ---------------------------------------------------------- */

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:vertical {
    background-color: {{color.bg_hover}};
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{color.text_muted}};
}

QScrollBar::handle:vertical:pressed {
    background-color: {{color.text_secondary}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background-color: {{color.bg_hover}};
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{color.text_muted}};
}

QScrollBar::handle:horizontal:pressed {
    background-color: {{color.text_secondary}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- Form inputs --------------------------------------------------------- */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox {
    background-color: {{color.bg_secondary}};
    color: {{color.text_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: 6px 10px;
    selection-background-color: {{color.accent}};
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus {
    border-color: {{color.accent}};
}

/* Visually mark a QLineEdit that is mirroring another field (e.g.
   the Stop hotkey field while "Use one hotkey for both" is on).
   Muted background + muted text reads as "tracking, not editable"
   without being completely invisible like a disabled widget. */
QLineEdit[muted="true"] {
    background-color: {{color.bg_elevated}};
    color: {{color.text_muted}};
    border-color: {{color.border}};
}

/* Validation feedback: red border when the user typed an
   unparseable hotkey combination.  Tooltip on the same widget
   carries the human-readable reason ("ctrl required for letter
   shortcuts", "f25 is not a valid key", etc.). */
QLineEdit[invalid="true"] {
    border-color: {{color.danger}};
}

QLineEdit[invalid="true"]:focus {
    border-color: {{color.danger}};
}

/* Inline warning banner used by the Settings → Hotkeys card to
   surface "macOS hasn't granted Accessibility access yet". Soft
   amber tint that draws the eye without alarming red of an error,
   plus an inline "Open Accessibility settings" button that uses
   the same QPushButton role styling as elsewhere. */
QFrame[role="warning-banner"] {
    background-color: rgba(245, 158, 11, 22);
    border: 1px solid {{color.warning}};
    border-radius: {{radius.sm}};
}

QLabel[role="warning-banner-text"] {
    color: {{color.text_primary}};
    background: transparent;
}

QFrame[role="warning-banner"] QPushButton {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
    border: none;
    border-radius: {{radius.sm}};
    padding: 6px 14px;
    font-weight: 600;
}

QFrame[role="warning-banner"] QPushButton:hover {
    background-color: {{color.warning_hover}};
}

/* Replace the native ``::drop-down`` rendering — Qt's default
   sub-control draws its own background on top of our rounded
   border, so the chevron looks like it's sitting in a square
   chip glued to the right edge. Make the area transparent and
   substitute a bundled chevron SVG. */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url("{{path.chevron_icon}}");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: {{color.bg_secondary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    selection-background-color: {{color.accent}};
    selection-color: {{color.text_primary}};
    padding: 4px;
}

QCheckBox {
    background-color: transparent;
    spacing: 10px;
    color: {{color.text_primary}};
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid {{color.border}};
    background-color: {{color.bg_elevated}};
}

QCheckBox::indicator:hover {
    border-color: {{color.accent_hover}};
}

QCheckBox::indicator:checked {
    background-color: {{color.accent}};
    border-color: {{color.accent}};
    image: url("{{path.styles_dir}}/check.svg");
}

QCheckBox::indicator:checked:hover {
    background-color: {{color.accent_hover}};
    border-color: {{color.accent_hover}};
}

QCheckBox::indicator:disabled {
    border-color: {{color.border}};
    background-color: {{color.bg_secondary}};
}

/* The checkbox is 16px total, so the ring is drawn inward: a 1px
   lighter border plus a 1px accent one inside it. Same 2px-as-one-
   pixel-at-this-size logic the buttons use. */
QCheckBox::indicator:focus {
    border: 2px solid {{color.accent}};
}

QCheckBox::indicator:checked:focus {
    border: 2px solid {{color.accent}};
    background-color: {{color.accent_hover}};
}

/* ---- Tables -------------------------------------------------------------- */

QTableView {
    background-color: {{color.bg_secondary}};
    alternate-background-color: {{color.bg_elevated}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    gridline-color: {{color.border}};
    selection-background-color: {{color.accent}};
    /* Suppress the per-cell focus rectangle Qt draws by default —
       the row-selection background already gives the user enough of
       a "this row is active" cue, the extra dotted border on the
       focused cell looked like a stray artifact next to the
       scrollbar. */
    outline: none;
}

QTableView:focus {
    /* Re-state the resting border so the table doesn't flash to
       a blue 'focused' frame when the user clicks into it. */
    border: 1px solid {{color.border}};
}

QHeaderView::section {
    background-color: {{color.bg_elevated}};
    color: {{color.text_secondary}};
    padding: 6px 10px;
    border: none;
    border-right: 1px solid {{color.border}};
    border-bottom: 1px solid {{color.border}};
    font-weight: 600;
}

QHeaderView::section:last {
    border-right: none;
}


/* ---- Transcribe view ----------------------------------------------------- */

QFrame#TranscribeDropZone {
    border: 2px dashed {{color.border}};
    border-radius: {{radius.lg}};
    background-color: {{color.bg_secondary}};
}

QFrame#TranscribeDropZone[dropState="active"] {
    border-color: {{color.accent}};
    background-color: {{color.bg_elevated}};
}

QLabel#TranscribeDropPrompt {
    color: {{color.text_secondary}};
    font-size: {{font.size_transcript}};
    background: transparent;
    border: none;
}

QFrame#TranscribeDropZone[dropState="active"] QLabel#TranscribeDropPrompt {
    color: {{color.text_primary}};
}

QLabel#TranscribeDropFormats {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
    background: transparent;
    border: none;
}

/* The two pages stacked inside the drop zone.  The stack is the one
   that actually paints: a QStackedWidget is a QFrame, has no rule of
   its own, and falls back to the palette window colour — bg_primary.
   Inside a zone whose own background is bg_secondary that reads as a
   dark rectangle drawn within a lighter one: a box inside a box, which
   the eye files as a nested card.  The pages are plain QWidgets and
   already don't paint; naming them here keeps that explicit. */
QStackedWidget#TranscribeSourceStack,
QWidget#TranscribeSourcePage {
    background: transparent;
    border: none;
}

/* ---- The loaded source ---------------------------------------------------
   The drop zone collapses to these two lines once a file is in play.
   The filename is the thing you actually need to recognise — after the
   third file in a row, "which one is this?" is a real question — so it
   takes the primary ink and the metadata steps back to muted. */

QLabel#TranscribeFileName {
    color: {{color.text_primary}};
    font-size: {{font.size_body}};
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#TranscribeFileMeta {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
    background: transparent;
    border: none;
}

QLabel#TranscribeStatus {
    color: {{color.text_secondary}};
    font-size: {{font.size_body}};
}

/* "Transcribing foo.wav…" is emphasis, not a hue.

   It was ``accent_hover`` — a hover-ramp value on a state that has
   nothing to do with hovering, and after ``text_muted`` was lifted it
   would have been the same ink as every caption in the app. A work-in-
   progress message is the most important line on the pane right now,
   so it takes ink weight rather than a colour. The four states that
   genuinely are states keep their own. */
QLabel#TranscribeStatus[status="busy"] {
    color: {{color.text_primary}};
}

QLabel#TranscribeStatus[status="done"] {
    color: {{color.success}};
}

QLabel#TranscribeStatus[status="warning"] {
    color: {{color.warning}};
}

QLabel#TranscribeStatus[status="error"] {
    color: {{color.danger}};
}

/* A READING SURFACE IS A WELL. Both text panes sit on the window
   ground, not on a card. They are the one place in the app whose whole
   job is to be read, and light-on-dark reads hardest on the deepest
   plane — so the pane is sunk into the ground and kept in shape by its
   hairline rather than raised off it.

   This is also what buys the log its red. Gruvbox tops out at bright_red
   #fb4934, and that value measures 4.29:1 on bg_secondary and 3.82:1 on
   bg_elevated — both under AA for 11px text. On bg_primary it is 4.77:1.
   No red in the palette clears 4.5:1 on any lighter plane, so a coloured
   error line and a card-level surface are mutually exclusive here; the
   surface moved, not the colour. */
QPlainTextEdit#TranscribeOutput {
    background-color: {{color.bg_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}};
    padding: 12px;
    color: {{color.text_primary}};
    font-size: {{font.size_transcript}};
}

/* Log lines, monospaced. This rule did not exist: the Logs view had no
   QSS at all and inherited the UI face, so timestamps, levels and
   module names never lined up and a stack of log rows read as prose.
   Proportional digits are the specific problem — a column of "10ms"
   and "9ms" is unreadable when the digits have different widths. */
QPlainTextEdit#LogsTextArea {
    background-color: {{color.bg_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}};
    padding: 12px 14px;
    color: {{color.text_secondary}};
    font-family: {{font.mono}};
    font-size: {{font.size_small}};
}
